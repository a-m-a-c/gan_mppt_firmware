{
  // Two-space indentation, per the conventions in .agents/workflow.md.
  // detectIndentation must be off: left on, VS Code infers the width from
  // whatever the open file happens to contain and silently overrides tabSize,
  // so a file that is still 4-space stays 4-space forever.
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // The tools/ scripts follow PEP 8, which is 4 -- the firmware convention
  // does not apply to them.
  "[python]": {
    "editor.tabSize": 4
  },

  // Use the CMake + Ninja + ARM GCC that ship with STM32CubeCLT.
  // These are on the machine PATH already, so this injection is redundant --
  // it is kept deliberately to pin CMake Tools' configure and build steps to
  // CubeCLT's copies regardless of what else lands on PATH later (Vivado also
  // ships a ninja). The generated toolchain file
  // (cmake/gcc-arm-none-eabi.cmake) finds "arm-none-eabi-gcc" via PATH.
  "cmake.cmakePath": "C:/ST/STM32CubeCLT_1.22.0/CMake/bin/cmake.exe",
  "cmake.useCMakePresets": "always",
  "cmake.configureEnvironment": {
    "PATH": "C:\\ST\\STM32CubeCLT_1.22.0\\CMake\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\Ninja\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\GNU-tools-for-STM32\\bin;${env:PATH}"
  },
  "cmake.buildEnvironment": {
    "PATH": "C:\\ST\\STM32CubeCLT_1.22.0\\CMake\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\Ninja\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\GNU-tools-for-STM32\\bin;${env:PATH}"
  },

  // Point IntelliSense at the compile_commands.json CMake generates
  // (CMAKE_EXPORT_COMPILE_COMMANDS is already ON in the CubeMX CMakeLists).
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#2a7f59",
    "activityBar.background": "#2a7f59",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#c39fdf",
    "activityBarBadge.foreground": "#15202b",
    "activityBarTop.activeBackground": "#2a7f59",
    "activityBarTop.background": "#2a7f59",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.border": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "sash.hoverBorder": "#2a7f59",
    "statusBar.background": "#1d593e",
    "statusBar.debuggingBackground": "#1d593e",
    "statusBar.debuggingForeground": "#e7e7e7",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#2a7f59",
    "statusBarItem.remoteBackground": "#211030",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#1d593e",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#1d593e99",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#1d593e"
}
